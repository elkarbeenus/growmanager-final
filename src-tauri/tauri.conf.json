{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "growmanager",
    "version": "0.5.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "open": true
      },
      "dialog": {
        "all": false,
        "save": true
      },
      "fs": {
        "all": false,
        "writeFile": true,
        "scope": [
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$HOME/**"
        ]
      },
      "window": {
        "all": false,
        "close": true,
        "setSize": true,
        "setPosition": true,
        "maximize": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.growmanager.app",
      "icon": [
        "icons/icon.png",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 820,
        "resizable": true,
        "title": "growmanager",
        "width": 1200,
        "minWidth": 420,
        "minHeight": 480,
        "center": true
      }
    ]
  }
}
